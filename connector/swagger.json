  "definitions": {
    "EmailRequest": {
      "properties": {
        "email_address": {
          "type": "string",
          "maxLength": 250,
          "minLength": 5,
          "title": "Email Address",
          "description": "Email address of the recipient."
        },
        "template_id": {
          "type": "string",
          "title": "Template Id",
          "description": "ID of the email template."
        },
        "personalisation": {
          "title": "Personalisation",
          "description": "Values for the template's placeholders. Values may be strings, numbers, or a list (rendered as bullet points). To attach a file, pass an object with a base64 'file' key, plus optional 'filename', 'confirm_email_before_download' and 'retention_period'.",
          "additionalProperties": true,
          "type": "object",
          "x-nullable": true
        },
        "reference": {
          "title": "Reference",
          "description": "Your own identifier for a notification or batch of notifications. Must not contain personal information.",
          "type": "string",
          "x-nullable": true
        },
        "email_reply_to_id": {
          "title": "Email Reply To Id",
          "description": "ID of a reply-to address configured on your service. Leave out to use the default.",
          "type": "string",
          "x-nullable": true
        },
        "one_click_unsubscribe_url": {
          "title": "One Click Unsubscribe Url",
          "description": "URL that unsubscribes the recipient in response to an empty POST. Required for subscription emails.",
          "type": "string",
          "x-nullable": true
        },
        "sanitise_content_for": {
          "title": "Sanitise Content For",
          "description": "Names of personalisation fields whose content Notify should sanitise: Markdown is escaped and URLs are removed.",
          "items": {
            "type": "string"
          },
          "type": "array",
          "x-nullable": true
        }
      },
      "additionalProperties": true,
      "type": "object",
      "required": [
        "email_address",
        "template_id"
      ],
      "title": "EmailRequest"
    },
    "HTTPValidationError": {
      "properties": {
        "detail": {
          "items": {
            "$ref": "#/definitions/ValidationError"
          },
          "type": "array",
          "title": "Detail"
        }
      },
      "type": "object",
      "title": "HTTPValidationError"
    },
    "LetterRequest": {
      "properties": {
        "template_id": {
          "type": "string",
          "title": "Template Id",
          "description": "ID of the letter template."
        },
        "personalisation": {
          "additionalProperties": true,
          "type": "object",
          "title": "Personalisation",
          "description": "The recipient's address plus any template placeholders. The address needs at least three lines: address_line_1 and address_line_2 must contain alphanumeric characters, and the last line used must be a UK postcode or a country outside the UK."
        },
        "reference": {
          "title": "Reference",
          "description": "Your own identifier for a notification or batch of notifications. Must not contain personal information.",
          "type": "string",
          "x-nullable": true
        }
      },
      "additionalProperties": true,
      "type": "object",
      "required": [
        "template_id",
        "personalisation"
      ],
      "title": "LetterRequest",
      "description": "A letter built from a template."
    },
    "PrecompiledLetterRequest": {
      "properties": {
        "reference": {
          "type": "string",
          "title": "Reference",
          "description": "Your own identifier for a notification or batch of notifications. Must not contain personal information."
        },
        "content": {
          "type": "string",
          "title": "Content",
          "description": "The letter as a base64 encoded PDF."
        },
        "postage": {
          "title": "Postage",
          "description": "Postage class, for example 'first' or 'second'.",
          "type": "string",
          "x-nullable": true
        }
      },
      "additionalProperties": true,
      "type": "object",
      "required": [
        "reference",
        "content"
      ],
      "title": "PrecompiledLetterRequest",
      "description": "A letter supplied as a ready-made PDF.\n\nNotify accepts this on the same endpoint as a templated letter; it is a\nseparate operation here so that each has a single, unambiguous schema for\nthe Azure custom connector."
    },
    "SmsRequest": {
      "properties": {
        "phone_number": {
          "type": "string",
          "maxLength": 15,
          "minLength": 7,
          "title": "Phone Number",
          "description": "Phone number of the recipient. UK or international.",
          "example": "+447900900123"
        },
        "template_id": {
          "type": "string",
          "title": "Template Id",
          "description": "ID of the text message template.",
          "example": "f33517ff-2a88-4f6e-b855-c550268ce08a"
        },
        "personalisation": {
          "title": "Personalisation",
          "description": "Values for the template's placeholders. Values may be strings, numbers, or a list (rendered as bullet points). To attach a file, pass an object with a base64 'file' key, plus optional 'filename', 'confirm_email_before_download' and 'retention_period'.",
          "additionalProperties": true,
          "type": "object",
          "x-nullable": true
        },
        "reference": {
          "title": "Reference",
          "description": "Your own identifier for a notification or batch of notifications. Must not contain personal information.",
          "type": "string",
          "x-nullable": true
        },
        "sms_sender_id": {
          "title": "Sms Sender Id",
          "description": "ID of a text message sender configured on your service. Leave out to use the default sender.",
          "type": "string",
          "x-nullable": true
        }
      },
      "additionalProperties": true,
      "type": "object",
      "required": [
        "phone_number",
        "template_id"
      ],
      "title": "SmsRequest"
    },
    "TemplatePreviewRequest": {
      "properties": {
        "personalisation": {
          "title": "Personalisation",
          "description": "Values for the template's placeholders. Values may be strings, numbers, or a list (rendered as bullet points). To attach a file, pass an object with a base64 'file' key, plus optional 'filename', 'confirm_email_before_download' and 'retention_period'.",
          "additionalProperties": true,
          "type": "object",
          "x-nullable": true
        }
      },
      "additionalProperties": true,
      "type": "object",
      "title": "TemplatePreviewRequest"
    },
    "TokenRequest": {
      "properties": {
        "api_key": {
          "type": "string",
          "minLength": 1,
          "title": "Api Key",
          "description": "A Notify API key: {key_name}-{iss-uuid}-{secret-key-uuid}"
        }
      },
      "type": "object",
      "required": [
        "api_key"
      ],
      "title": "TokenRequest"
    },
    "TokenResponse": {
      "properties": {
        "token": {
          "type": "string",
          "title": "Token"
        },
        "key_name": {
          "type": "string",
          "title": "Key Name"
        },
        "iss": {
          "type": "string",
          "title": "Iss"
        },
        "iat": {
          "type": "integer",
          "title": "Iat"
        },
        "expires_in": {
          "type": "integer",
          "title": "Expires In"
        }
      },
      "type": "object",
      "required": [
        "token",
        "key_name",
        "iss",
        "iat",
        "expires_in"
      ],
      "title": "TokenResponse"
    },
    "ValidationError": {
      "properties": {
        "loc": {
          "items": {},
          "type": "array",
          "title": "Location"
        },
        "msg": {
          "type": "string",
          "title": "Message"
        },
        "type": {
          "type": "string",
          "title": "Error Type"
        },
        "input": {
          "title": "Input"
        },
        "ctx": {
          "type": "object",
          "title": "Context"
        }
      },
      "type": "object",
      "required": [
        "loc",
        "msg",
        "type"
      ],
      "title": "ValidationError"
    }
  }
}
