    "/v2/notifications": {
      "get": {
        "operationId": "GetNotifications",
        "summary": "Get the status of multiple messages",
        "description": "Get the status of multiple messages",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "description": "Filter by delivery status.",
            "x-ms-summary": "Filter by delivery status",
            "type": "string",
            "enum": [
              "accepted",
              "created",
              "sending",
              "pending",
              "sent",
              "received",
              "delivered",
              "cancelled",
              "pending-virus-check",
              "virus-scan-failed",
              "validation-failed",
              "permanent-failure",
              "temporary-failure",
              "technical-failure"
            ]
          },
          {
            "name": "template_type",
            "in": "query",
            "required": false,
            "description": "Filter by message type.",
            "x-ms-summary": "Filter by message type",
            "type": "string",
            "enum": [
              "email",
              "sms",
              "letter"
            ]
          },
          {
            "name": "reference",
            "in": "query",
            "required": false,
            "description": "Filter by your own reference.",
            "x-ms-summary": "Filter by your own reference",
            "type": "string"
          },
          {
            "name": "older_than",
            "in": "query",
            "required": false,
            "description": "Return the next page: messages older than this notification ID.",
            "x-ms-summary": "Return the next page: messages older than this notification ID",
            "type": "string"
          },
          {
            "name": "include_jobs",
            "in": "query",
            "required": false,
            "description": "Include messages sent from an uploaded CSV file.",
            "x-ms-summary": "Include messages sent from an uploaded CSV file",
            "type": "boolean"
          },
          {
            "name": "x-proxy-key",
            "in": "header",
            "required": false,
            "x-ms-summary": "x-proxy-key",
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "schema": {}
          },
          "422": {
            "description": "Validation Error",
            "schema": {
              "$ref": "#/definitions/HTTPValidationError"
            }
          }
        }
      }
