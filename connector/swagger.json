{
  "swagger": "2.0",
  "info": {
    "title": "Notify JWT service",
    "description": "Signs requests to the GOV.UK Notify API. The /v2 routes mirror Notify's own and add the JWT, so a caller that can only hold a static credential never has to deal with a token that expires after 30 seconds. POST /token returns a bare token instead, for callers that want to make the onward call themselves.",
    "version": "2.0.0"
  },
  "host": "notify-proxy.example.com",
  "basePath": "/",
  "schemes": [
    "https"
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "securityDefinitions": {
    "proxyKey": {
      "type": "apiKey",
      "in": "header",
      "name": "X-Proxy-Key",
      "description": "Shared secret for this proxy. Leave the connector's API key blank if the service is protected by Cloudflare Access instead."
    }
  },
  "security": [
    {
      "proxyKey": []
    }
  ],
